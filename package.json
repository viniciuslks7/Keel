{
  "name": "keel",
  "version": "0.1.0",
  "description": "Double-entry ledger service — hexagonal architecture, idempotent money movement, keyset pagination, raw SQL.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "build:demo": "tsx scripts/build-demo.ts",
    "preview:demo": "npm run build:demo && tsx scripts/serve-demo.ts",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:postgres": "node scripts/check-postgres-test-env.mjs && vitest run tests/integration/postgres.test.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "migrate": "tsx scripts/migrate.ts"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "fastify": "^5.2.0",
    "pg": "^8.13.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11"
  }
}
